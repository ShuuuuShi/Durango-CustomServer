<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DurangoServer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <!--
    เซิร์ฟนี้พอร์ตตรงจากเซิร์ฟในตัวของเกม (Durango.Online เดิมชื่อ Durango.Offline — เปลี่ยนชื่อ
    4 ก.ย. 2026 เพราะโปรเจกต์นี้ทำเวอร์ชัน Online เท่านั้น)
      Core/     = ตัวเซิร์ฟที่พอร์ตมา
      Support/  = shim แทนของที่อยู่ใน Unity (Yaml/prototype/สี/แปลภาษา)
      GameCode/ = ชั้น protocol + data ของเกมต้นฉบับ (Messages/ 985 ตัว TypeCode ตรง 100%)
      Shims/    = UnityEngine shim (Mathf/Vector/Random/Debug)
    ต่างจากโปรเจกต์เดิมตรงที่ GameCode/Shims อยู่ในโฟลเดอร์นี้จริง ไม่ได้ link ข้ามโปรเจกต์
  -->

  <!-- terrain zips (ฟอร์แมตเดียวกับตัวแท้: whole.biomes/ocean/rivers/landmarks + info.yml) -->
  <ItemGroup>
    <!-- คำแปลไทย 33,262 ข้อความ (เกาหลี → ไทย) — เซิร์ฟต้องแปลเอง เพราะชื่อไอเทม/สิ่งปลูกสร้าง
         ถูกส่งเป็น "ข้อความสำเร็จรูป" ไปให้เกม ไม่ได้ส่ง msgid ให้เกมแปลผ่าน catalog ของตัวเอง
         (client/Durango.Logic.Item/ItemData.cs:132 `Name = itemInfo.Name` รับมาแล้วโชว์ตรง ๆ) -->
    <None Include="data\locales\**\*.mo">
      <Link>data\locales\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="data\terrains\*.zip">
      <Link>data\terrains\%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- หน้าแอดมิน — Gateway หาไฟล์จาก <ข้าง exe>/admin (Core/Gateway.cs:846)
         ไม่ก๊อปไปด้วย = เปิด /admin แล้วได้ "Admin UI ไม่พบ" ทุกครั้ง -->
    <None Include="admin\**\*.*">
      <Link>admin\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="data\assets\**\*.json">
      <Link>data\assets\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
