# log ของเซิร์ฟเขียนแบบ append ผ่าน systemd ⇒ ไม่มีใครหมุนให้ โตจนดิสก์เต็มได้
# copytruncate เพราะ systemd ถือ fd ค้างไว้ ถ้า rename เฉย ๆ มันจะเขียนลงไฟล์เก่าต่อ
/var/log/durango-lasthuman.log /var/log/durango-lasthuman.err /var/log/durango-lasthuman-backup.log {
    weekly
    rotate 8
    maxsize 200M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
