<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Proximity Voice Chat (GTA-style) — client mod for Durango LastHuman
    build:  dotnet build tools\ProximityVoiceMod -c Release
    install: copy bin\Release\net35\ProximityVoiceMod.dll -> game\mods\ProximityVoice\
  -->
  <PropertyGroup>
    <AssemblyName>ProximityVoiceMod</AssemblyName>
    <RootNamespace>ProximityVoiceMod</RootNamespace>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DurangoClientModSdk">
      <HintPath>..\..\game\Durango_Data\Managed\DurangoClientModSdk.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\game\Durango_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\game\Durango_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>..\..\game\Durango_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\..\game\Durango_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\game\Durango_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\game\Durango_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
